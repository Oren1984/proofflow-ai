# Copy to .env to override defaults. Everything works offline with the defaults below.

# "mock" (default, deterministic, no network) or "llm" (optional, advisory only)
PROOFFLOW_AI_MODE=mock

# Only used when PROOFFLOW_AI_MODE=llm. Never commit a real key.
# The Docker image must also be built with INSTALL_LLM=true to include the client library.
ANTHROPIC_API_KEY=
INSTALL_LLM=false
PROOFFLOW_LLM_MODEL=claude-opus-5-5
PROOFFLOW_LLM_TIMEOUT_S=20

# Upload limit per evidence file, in MB. To go above 5, also raise server.maxUploadSize
# in .streamlit/config.toml (Streamlit enforces its own limit first).
PROOFFLOW_MAX_UPLOAD_MB=5

# Seed the synthetic demo project when the database is empty
PROOFFLOW_SEED_DEMO=true

# Local (non-Docker) runs only: where the SQLite database and evidence files are stored
# PROOFFLOW_DATA_DIR=data
